{
  "name": "cardboard",
  "version": "0.3.0",
  "description": "A smart, private, end-to-end encrypted deposit box for all your personal apps.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "cardboard": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./account": {
      "types": "./dist/client/account.d.ts",
      "default": "./dist/client/account.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "start": "node src/cli.ts start",
    "cli": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "~5.9.3"
  }
}
